# Google OAuth (mesmas creds do projeto Next.js principal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Secret compartilhado entre Next.js e este servidor
SERVER_SECRET=

# URL do site Next.js (pra CORS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Porta (Render injeta automatico, deixa em branco em prod)
PORT=10000

# ─── Auto-indexacao (so funciona rodando local, pq le ../data/) ───
# 1 = ativa loop automatico, 0 = manual apenas
AUTO_INDEX_ENABLED=0
# Minutos entre cada ciclo (recomendado: 30+)
AUTO_INDEX_INTERVAL_MIN=30
# Caminhos dos JSONs do Next.js (default: ../data/...)
EVENTOS_PATH=
PERFIS_PATH=
